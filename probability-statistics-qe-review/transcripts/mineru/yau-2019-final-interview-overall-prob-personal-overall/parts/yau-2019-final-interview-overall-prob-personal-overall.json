[{"bbox":[449,123,547,138],"page_idx":0,"text":"May 2019","text_level":2,"type":"text"},{"bbox":[114,156,720,172],"page_idx":0,"text":"1. Let $\\{ S _ { n } \\}$ be a simple random walk in one dimension, with $S _ { 0 } = 0$ , and let","type":"text"},{"bbox":[374,186,620,205],"page_idx":0,"text":"$$\n\\tau = \\tau_ {[ 0, 5 ] ^ {c}} = \\inf \\{n: S _ {n} \\notin [ 0, 5 ] \\}\n$$","text_format":"latex","type":"equation"},{"bbox":[112,217,745,252],"page_idx":0,"text":"be the first time the random walk exits the set {0, 1, 2, 3, 4, 5}. Evaluate $\\mathbb { E } [ S _ { \\tau - 1 } ]$ (Hint: use Wald’s identity)","type":"text"},{"bbox":[112,268,379,284],"page_idx":0,"text":"2. Prove that for any two events,","type":"text"},{"bbox":[374,294,622,327],"page_idx":0,"text":"$$\n\\left| \\mathbf {P} \\{A \\cap B \\} - \\mathbf {P} \\{A \\} \\mathbf {P} \\{B \\} \\right| \\leq \\frac {1}{4}\n$$","text_format":"latex","type":"equation"},{"bbox":[112,338,148,352],"page_idx":0,"text":"and","type":"text"},{"bbox":[354,353,640,372],"page_idx":0,"text":"$$\n\\mathbf {P} \\{A \\cup B \\} \\mathbf {P} \\{A \\cap B \\} \\leq \\mathbf {P} \\{A \\} \\mathbf {P} \\{B \\}.\n$$","text_format":"latex","type":"equation"},{"bbox":[292,90,704,107],"page_idx":0,"text":"Probability problems: personal-overall","type":"header"},{"bbox":[493,934,504,948],"page_idx":0,"text":"1","type":"page_number"}]